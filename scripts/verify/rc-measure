#!/bin/sh
# rc-measure [--print] <alias> <label>: the measurements of 10.4 against the
# rehearsal servers (PLAN 9.2 step 5, P3-04).
#
# Runs the three real-machine tests of P3-05b (TestRemoteDiscoveryHeldAndCold,
# TestSwitchLocalHeldCold, TestInputLatencyRemote) from the checkout
# ~/.cache/devtools-rc/src, inside its dev shell, with the environment of
# rc-attach (rc-ssh as ssh, XDG_CONFIG_HOME, DEVTOOLS_SERVICE) and
# DEVTOOLS_E2E_BIN, DEVTOOLS_E2E_REAL=1, DEVTOOLS_E2E_REMOTE=<alias>,
# DEVTOOLS_E2E_QUERY=<label>. Prints each measured value beside its
# threshold and the revision measured. It uses ssh to <alias> and creates
# one scratch session on each machine: run by the user (9.6).
set -u
PROG=${0##*/}
HERE=$(cd "$(dirname "$0")" && pwd -P) || exit 1
# shellcheck source=scripts/verify/lib.sh
. "$HERE/lib.sh"
USAGE='rc-measure [--print] <alias> <label>'

print=
if [ "${1-}" = --print ]; then
	print=1
	shift
fi
[ $# -eq 2 ] || usage
alias=$1 label=$2
case $alias in '' | -* | *[!A-Za-z0-9._-]*) die "not an ssh host alias: $alias" ;; esac
refuse_multiplexer_env

SRC=$RC/src
TESTS='^(TestRemoteDiscoveryHeldAndCold|TestSwitchLocalHeldCold|TestInputLatencyRemote)$'
unset DEVTOOLS_MULTIPLEXER XDG_STATE_HOME
set -- env PATH="$RC_SSH_DIR:$PATH" XDG_CONFIG_HOME="$RC_CONFIG" DEVTOOLS_SERVICE="$RC_SERVICE" \
	DEVTOOLS_E2E_BIN="$RC_BIN" DEVTOOLS_E2E_REAL=1 DEVTOOLS_E2E_REMOTE="$alias" DEVTOOLS_E2E_QUERY="$label" \
	nix develop -c go test ./internal/e2e/ -run "$TESTS" -count=1 -v

if [ -n "$print" ]; then
	say "cd $(shquote "$SRC")"
	print_cmd "$@"
	exit 0
fi

[ -x "$RC_BIN" ] || die "no candidate at $RC_BIN; run rc-install first"
[ -d "$SRC/internal/e2e" ] || die "no checkout of the candidate at $SRC (README.md)"
ensure_ssh_standin
built=unknown
[ -f "$RC/revision" ] && built=$(cut -d' ' -f1 "$RC/revision")
src=$(git -C "$SRC" rev-parse HEAD 2>/dev/null) || src=unknown
say "revision measured: $built (binary), $src (tests in $SRC)"
case $built in
"$src" | unknown) ;;
*) warn "the binary and the tests are of different revisions" ;;
esac

log=$(mktemp "${TMPDIR:-/tmp}/rc-measure.XXXXXX") || die "mktemp failed"
trap 'rm -f "$log"' EXIT
(cd "$SRC" && "$@") >"$log" 2>&1
rc=$?

# The measured values: every line in which a test names a threshold, T1 to
# T10 (10.4). Provisional (P3-05a): the -v output of internal/e2e prints each
# value beside its threshold on one line that names its id; the exact form is
# P3-05a's and is not known when this script was written.
say "measured (alias $alias, label $label):"
grep -E '(^|[^A-Za-z0-9])T([1-9]|10)b?([^0-9]|$)|threshold' "$log" | sed 's/^[[:space:]]*/  /'
grep -E '^(--- |ok |FAIL|PASS)' "$log" | sed 's/^/  /'
if [ "$rc" -ne 0 ]; then
	say "the tests failed (exit $rc); their output:"
	sed 's/^/  | /' "$log"
	exit 1
fi
