#!/bin/sh
# rc-ssh: the stand-in for ssh on the PATH of the rehearsal client (PLAN 9.2,
# P3-04). rc-attach and rc-measure link it as "ssh" into ~/.cache/devtools-rc/bin.
#
# When the last two arguments are "devtools bridge" (the bridge command line
# of 4.4) they become ".cache/devtools-rc/result/bin/devtools bridge", the
# candidate in the home directory of the other machine; then the real ssh
# runs. Every other argument list goes to the real ssh unchanged. No product
# code knows about this script.
#
# rc-ssh --print <ssh argument>... prints the argument list it would run.
set -u
PROG=${0##*/}
# $0 is usually the link ~/.cache/devtools-rc/bin/ssh; lib.sh is beside the
# file it points to.
self=$0
while [ -L "$self" ]; do
	target=$(readlink "$self")
	case $target in
	/*) self=$target ;;
	*) self=$(dirname "$self")/$target ;;
	esac
done
HERE=$(cd "$(dirname "$self")" && pwd -P) || exit 1
# shellcheck source=scripts/verify/lib.sh
. "$HERE/lib.sh"

print=
if [ "${1-}" = --print ]; then
	print=1
	shift
fi

# real_ssh finds the first ssh on PATH that is not this script.
real_ssh() {
	_self=$HERE/rc-ssh
	_stand=$(cd "$RC_SSH_DIR" 2>/dev/null && pwd -P) || _stand=$RC_SSH_DIR
	_ifs=$IFS
	IFS=:
	for _dir in $PATH; do
		IFS=$_ifs
		[ -n "$_dir" ] && [ -x "$_dir/ssh" ] && [ ! -d "$_dir/ssh" ] || continue
		_dirabs=$(cd "$_dir" 2>/dev/null && pwd -P) || continue
		[ "$_dirabs" = "$HERE" ] && continue
		[ "$_dirabs" = "$_stand" ] && continue
		if [ -L "$_dir/ssh" ]; then
			_target=$(readlink "$_dir/ssh")
			case $_target in
			"$_self" | */rc-ssh | rc-ssh) continue ;;
			esac
		fi
		printf '%s\n' "$_dir/ssh"
		return 0
	done
	IFS=$_ifs
	return 1
}

# Rewrite: rebuild "$@" with the last two words replaced when they are the
# bridge command. Positional parameters are the only array of POSIX sh.
n=$#
if [ "$n" -ge 2 ]; then
	_last='' _prev=''
	eval "_last=\${$n} _prev=\${$((n - 1))}"
	if [ "$_prev" = devtools ] && [ "$_last" = bridge ]; then
		_i=0
		for _arg do
			_i=$((_i + 1))
			if [ "$_i" -eq 1 ]; then set --; fi
			if [ "$_i" -le $((n - 2)) ]; then set -- "$@" "$_arg"; fi
		done
		set -- "$@" .cache/devtools-rc/result/bin/devtools bridge
	fi
fi

ssh=$(real_ssh) || ssh=
if [ -n "$print" ]; then
	print_cmd "${ssh:-ssh}" "$@"
	exit 0
fi
[ -n "$ssh" ] || die "no ssh on PATH besides this stand-in"
exec "$ssh" "$@"
